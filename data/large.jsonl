python - <<'PY'
import json
import random
import pathlib

assets = ["USD", "EUR", "GBP", "JPY", "XAU", "XAG"]
types = {
    "USD": "currency",
    "EUR": "currency",
    "GBP": "currency",
    "JPY": "currency",
    "XAU": "metal",
    "XAG": "metal",
}

with pathlib.Path("data/large.jsonl").open("w", encoding="utf-8") as f:
    for i in range(200_000):
        asset = random.choice(assets)

        row = {
            "date": f"2026-10-{(i % 30) + 1:02d}",
            "asset": asset,
            "type": types[asset],
            "rate": round(random.uniform(10, 5000), 2)
        }

        f.write(json.dumps(row, ensure_ascii=False) + "\n")
PY
